{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-home-read-recursive",
    "fs:allow-home-write-recursive",
    {
      "identifier": "fs:write-files",
      "allow": [
        "$HOME/**",
        "$AUDIO/**",
        "$DOWNLOAD/**",
        "**"
      ]
    },
    {
      "identifier": "fs:read-files",
      "allow": [
        "$HOME/**",
        "$AUDIO/**",
        "$DOWNLOAD/**",
        "**"
      ]
    }
  ]
}